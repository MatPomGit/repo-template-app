{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research:app:event:1",
  "title": "Example research event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "timestamp_utc",
    "source",
    "event_type",
    "quality",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "quality": {
      "enum": [
        "synthetic",
        "valid",
        "invalid",
        "not_verified"
      ]
    },
    "equipment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
